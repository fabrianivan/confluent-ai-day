# Google Cloud / OS environment variables for INATEWS SENTINEL
# Copy these into the VM / runtime environment with export or use gcloud run --set-env-vars

# Core app
export SERVER_PORT="8080"
export CORS_ORIGIN="https://your-frontend-domain"
export DEMO_MODE="false"

# Confluent Kafka
export CONFLUENT_BOOTSTRAP_SERVERS="pkc-xxxxx.region.provider.confluent.cloud:9092"
export CONFLUENT_API_KEY="your-kafka-api-key"
export CONFLUENT_API_SECRET="your-kafka-api-secret"
export CONFLUENT_SCHEMA_REGISTRY_URL="https://psrc-xxxxx.region.provider.confluent.cloud"
export CONFLUENT_SR_API_KEY="your-schema-registry-key"
export CONFLUENT_SR_API_SECRET="your-schema-registry-secret"

# LLM / AI
export AI_PROVIDER="gemini"
export GEMINI_API_KEY="your-gemini-api-key"

# AWS Bedrock (optional if using Gemini)
export AWS_REGION="us-east-1"
export AWS_ACCESS_KEY_ID="your-aws-access-key-id"
export AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
export AWS_SESSION_TOKEN=""
export AWS_BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"

# Frontend
export NEXT_PUBLIC_API_URL="https://your-backend-domain"

# Example for VM shell:
# source /path/to/gcp-env.example
# or
# set -a && source /path/to/gcp-env.example && set +a
