# ============================================
# INATEWS SENTINEL — Environment Configuration
# ============================================

# Confluent Cloud Kafka
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
CONFLUENT_API_KEY=your-kafka-api-key
CONFLUENT_API_SECRET=your-kafka-api-secret

# Confluent Schema Registry (Optional)
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
CONFLUENT_SR_API_KEY=your-sr-api-key
CONFLUENT_SR_API_SECRET=your-sr-api-secret

# AI Provider Selection: "gemini" or "bedrock"
AI_PROVIDER=gemini

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# AWS Bedrock AI
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Server
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:3000

# Standalone Demo Mode (true to run without external Kafka/AI credentials)
DEMO_MODE=false
